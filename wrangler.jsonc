{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fornada",
  "main": "worker/build/worker/shim.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "routes": [{ "pattern": "fornada.versoza.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  "placement": { "region": "aws:us-east-1" },
  "build": {
    "command": "scripts/build-web.sh && worker-build --profile worker worker",
    "watch_dir": ["worker/src", "game-core/src", "web"]
  },
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fornada",
      "database_id": "bfe90f69-0510-463d-98fa-3ebc192d494c",
      "migrations_dir": "migrations"
    }
  ]
}
